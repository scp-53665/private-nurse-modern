# Normalise line endings on checkout: the shell scripts must keep LF or Git Bash
# reports "bad interpreter".
* text=auto

*.sh  text eol=lf
*.py  text eol=lf
*.rs  text eol=lf
*.md  text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.def text eol=lf

*.zip binary
*.bmp binary
*.dll binary
*.exe binary
